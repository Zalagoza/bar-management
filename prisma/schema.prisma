// ============================================================================
// BAR MANAGEMENT SYSTEM — Prisma Schema
// ============================================================================
// Design notes:
// - BARTENDER role can only CREATE records (sales, stock receipts). No update/
//   delete endpoints exist for these tables in the app layer.
// - ADMIN role can view all reports, mark bills as paid, record operating
//   costs, salaries/wages, assets, loans and capital, and view the Journal
//   (book of records) and the Profit & Loss statement.
// - Every money-moving action (sale, stock purchase, expense, salary payment,
//   loan received/repaid, capital injected/withdrawn) automatically writes a
//   balanced double-entry JournalEntry (see lib/accounting.ts). The P&L and
//   all financial reports are derived FROM the journal, so the books always
//   reconcile — this is the "book of records" the requirements asked for.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USERS & AUTH
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  BARTENDER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sales           Sale[]
  stockReceipts   StockReceipt[]
  bills           Bill[]              @relation("BillCreatedBy")
  orders          Order[]             @relation("OrderCreatedBy")
  expenses        OperatingCost[]
  salaryPayments  SalaryPayment[]
  assetsRecorded  Asset[]
  loansRecorded   Loan[]
  capitalEntries  CapitalEntry[]
  journalEntries  JournalEntry[]
}

// ----------------------------------------------------------------------------
// PRODUCTS / STOCK (Beer & other bar inventory)
// ----------------------------------------------------------------------------

model Product {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "Carlsberg Green 500ml"
  category      String   @default("Beer") // Beer, Spirit, Soft Drink, Other
  unit          String   @default("bottle") // bottle, crate, can, etc.
  costPrice     Decimal  @db.Decimal(12, 2) // most recent purchase cost per unit
  sellingPrice  Decimal  @db.Decimal(12, 2) // current selling price per unit
  reorderLevel  Int      @default(12)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockReceipts StockReceipt[]
  saleItems     SaleItem[]
  orderItems    OrderItem[]

  @@index([category])
}

// Stock IN — recorded by bartender or admin when new stock arrives.
// IMMUTABLE: no update/delete route exists for this model.
model StockReceipt {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int // units received
  unitCost    Decimal  @db.Decimal(12, 2)
  totalCost   Decimal  @db.Decimal(12, 2)
  supplier    String?
  note        String?
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// SALES — recorded by bartender per shift. IMMUTABLE once created.
// ----------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  CREDIT // sold on credit -> becomes a receivable, tracked like a "bill" owed TO the bar
}

model Sale {
  id            String        @id @default(cuid())
  soldBy        User          @relation(fields: [soldById], references: [id])
  soldById      String
  paymentMethod PaymentMethod @default(CASH)
  customerName  String? // used when paymentMethod = CREDIT
  totalAmount   Decimal       @db.Decimal(12, 2)
  totalCost     Decimal       @db.Decimal(12, 2) // COGS snapshot at sale time
  note          String?
  createdAt     DateTime      @default(now())

  items SaleItem[]

  @@index([createdAt])
  @@index([soldById])
}

model SaleItem {
  id         String  @id @default(cuid())
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2) // price snapshot at sale time
  unitCost   Decimal @db.Decimal(12, 2) // cost snapshot at sale time

  @@index([productId])
}

// ----------------------------------------------------------------------------
// BILLS — money owed BY the bar to suppliers/creditors (unpaid bills).
// Recorded by name + amount as requested. Admin marks as paid (payment is a
// new, additional record — original bill row is never edited/deleted).
// ----------------------------------------------------------------------------

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Bill {
  id            String     @id @default(cuid())
  creditorName  String // who the bar owes
  description   String?
  amount        Decimal    @db.Decimal(12, 2)
  amountPaid    Decimal    @db.Decimal(12, 2) @default(0)
  status        BillStatus @default(UNPAID)
  dueDate       DateTime?
  createdBy     User       @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime   @default(now())

  payments BillPayment[]

  @@index([status])
}

// A payment against a bill — additive record, never edits the Bill row's
// original amount. Admin only.
model BillPayment {
  id        String   @id @default(cuid())
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId    String
  amount    Decimal  @db.Decimal(12, 2)
  paidVia   PaymentMethod @default(CASH)
  note      String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ORDERS — purchase orders placed to suppliers (distinct from stock receipt,
// which records what actually arrived). Useful for tracking pending orders.
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  supplier    String
  status      OrderStatus @default(PENDING)
  note        String?
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime    @default(now())

  items OrderItem[]

  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitCost  Decimal @db.Decimal(12, 2)
}

// ----------------------------------------------------------------------------
// OTHER OPERATING COSTS (rent, electricity, transport, cleaning, etc.)
// Admin-recorded expenditures.
// ----------------------------------------------------------------------------

model OperatingCost {
  id          String   @id @default(cuid())
  category    String // e.g. "Rent", "Electricity", "Transport", "Repairs"
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  paidVia     PaymentMethod @default(CASH)
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// SALARY / WAGES
// ----------------------------------------------------------------------------

model Employee {
  id          String   @id @default(cuid())
  name        String
  role        String // e.g. "Bartender", "Security", "Cleaner"
  monthlyRate Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  payments SalaryPayment[]
}

model SalaryPayment {
  id          String   @id @default(cuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  amount      Decimal  @db.Decimal(12, 2)
  periodLabel String // e.g. "August 2026"
  paidVia     PaymentMethod @default(CASH)
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

// ----------------------------------------------------------------------------
// ASSETS
// ----------------------------------------------------------------------------

model Asset {
  id           String        @id @default(cuid())
  name         String // e.g. "Fridge", "Pool Table", "Generator"
  category     String        @default("Equipment")
  value        Decimal       @db.Decimal(12, 2) // acquisition value
  paidVia      PaymentMethod @default(CASH)
  acquiredDate DateTime      @default(now())
  note         String?
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime      @default(now())
}

// ----------------------------------------------------------------------------
// LOANS (money borrowed by the business, or lent out)
// ----------------------------------------------------------------------------

enum LoanDirection {
  BORROWED // liability to the business
  LENT     // receivable to the business
}

model Loan {
  id           String        @id @default(cuid())
  counterparty String // lender/borrower name
  direction    LoanDirection
  principal    Decimal       @db.Decimal(12, 2)
  interestRate Decimal?      @db.Decimal(5, 2) // % per annum, optional
  paidVia      PaymentMethod @default(CASH)
  note         String?
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime      @default(now())

  repayments LoanRepayment[]
}

model LoanRepayment {
  id        String        @id @default(cuid())
  loan      Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String
  amount    Decimal       @db.Decimal(12, 2)
  paidVia   PaymentMethod @default(CASH)
  note      String?
  createdAt DateTime      @default(now())
}

// ----------------------------------------------------------------------------
// CAPITAL (owner contributions / drawings)
// ----------------------------------------------------------------------------

enum CapitalType {
  CONTRIBUTION // owner puts money in
  DRAWING      // owner takes money out
}

model CapitalEntry {
  id           String        @id @default(cuid())
  type         CapitalType
  amount       Decimal       @db.Decimal(12, 2)
  paidVia      PaymentMethod @default(CASH)
  note         String?
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime      @default(now())
}

// ----------------------------------------------------------------------------
// JOURNAL / BOOK OF RECORDS — double-entry ledger.
// Every business event above writes one balanced JournalEntry (a set of
// JournalLines whose debits == credits). This is the immutable "book of
// records" and the single source of truth the P&L statement is built from.
// ----------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id     String      @id @default(cuid())
  code   String      @unique // e.g. "1000", "4000"
  name   String // e.g. "Cash", "Sales Revenue", "Cost of Goods Sold"
  type   AccountType

  lines JournalLine[]
}

model JournalEntry {
  id           String        @id @default(cuid())
  date         DateTime      @default(now())
  memo         String // human-readable description, e.g. "Sale #abc123"
  sourceType   String // "SALE" | "STOCK_RECEIPT" | "BILL_PAYMENT" | "OPERATING_COST" | "SALARY" | "ASSET" | "LOAN" | "CAPITAL"
  sourceId     String // id of the originating record
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime      @default(now())

  lines JournalLine[]

  @@index([sourceType, sourceId])
  @@index([date])
}

model JournalLine {
  id      String       @id @default(cuid())
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String
  account Account      @relation(fields: [accountId], references: [id])
  accountId String
  debit   Decimal      @db.Decimal(12, 2) @default(0)
  credit  Decimal      @db.Decimal(12, 2) @default(0)

  @@index([accountId])
}
